#!/bin/bash
# Runs inside the image build against a NEW chroot; never on the live Pi.
set -euo pipefail
target="$(realpath -e -- "$1")"
test "$target" != /
payload="${IGconf_pysh_payload:?Missing verified payload}"
test -f "$payload/runtime.tar.gz"
test -f "$payload/manifest.json"
source_root="$(dirname "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")")"

install -d "$target/opt/pysh/current"
python3 - "$payload" "$target/opt/pysh/current" <<'PY'
import hashlib, json, sys, tarfile
from pathlib import Path
payload, root = map(Path, sys.argv[1:])
manifest = json.loads((payload / 'manifest.json').read_text())
archive = payload / 'runtime.tar.gz'
assert hashlib.sha256(archive.read_bytes()).hexdigest() == manifest['sha256']
with tarfile.open(archive) as bundle:
    entries = bundle.getmembers()
    assert all(m.isfile() and not Path(m.name).is_absolute() and '..' not in Path(m.name).parts for m in entries)
    assert {m.name for m in entries} == set(manifest['files'])
    bundle.extractall(root, filter='data')
for name, expected in manifest['files'].items():
    assert hashlib.sha256((root / name).read_bytes()).hexdigest() == expected, name
PY
chroot "$target" python3 -m venv /opt/pysh/venv
chroot "$target" /opt/pysh/venv/bin/pip install --no-cache-dir -r /opt/pysh/current/requirements.lock
chroot "$target" /opt/pysh/venv/bin/python -c "import sys;sys.path.insert(0,'/opt/pysh/current');import services.backend.app"

install -d "$target/etc/xdg/labwc" "$target/etc/greetd" "$target/usr/local/bin"
install -m 0755 "$source_root/assets/pysh-session" "$target/usr/local/bin/pysh-session"
install -m 0755 "$source_root/assets/labwc-autostart" "$target/etc/xdg/labwc/autostart"
install -m 0644 "$source_root/assets/greetd.toml" "$target/etc/greetd/config.toml"
install -D -m 0644 "$source_root/assets/pysh.service" "$target/etc/systemd/user/pysh.service"
install -D -m 0644 "$source_root/assets/journald.conf" "$target/etc/systemd/journald.conf.d/pysh.conf"
install -D -m 0644 "$payload/source.json" "$target/etc/pysh-build.json"
printf '%s\n' 'EXPERIMENTAL: hardware boot, service recovery and flash gate not yet accepted.' > "$target/etc/pysh-os-candidate"
chroot "$target" useradd --system --user-group --home /var/lib/pysh-greeter --create-home --shell /usr/sbin/nologin pysh-greeter
chroot "$target" systemctl enable greetd.service bluetooth.service NetworkManager.service
chroot "$target" systemctl mask systemd-networkd.service systemd-networkd.socket
# Image SSH stays unavailable until its recovery key has been provisioned.
install -d "$target/etc/systemd/system/ssh.service.d"
printf '[Unit]\nConditionPathExists=/home/pysh-admin/.ssh/authorized_keys\n' > "$target/etc/systemd/system/ssh.service.d/pysh-key-required.conf"
