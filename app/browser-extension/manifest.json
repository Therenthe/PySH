{
  "manifest_version": 3,
  "name": "Pi Smart Hub \u2014 Return",
  "version": "1.2.1",
  "description": "Touch controls for returning to PySH and opening the system keyboard. No account data is collected.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.netflix.com/*",
        "https://*.spotify.com/*",
        "https://accounts.google.com/*"
      ],
      "js": [
        "return.js"
      ],
      "css": [
        "immersive.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://open-meteo.com/*",
        "https://creativecommons.org/*"
      ],
      "js": [
        "documentation.js"
      ],
      "css": ["immersive.css"],
      "run_at": "document_start"
    }
  ],
  "key": "",
  "permissions": [
    "nativeMessaging",
    "webNavigation"
  ]
}
