{
  "name": "pysh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "typecheck": "tsc -b --pretty",
    "test:ui": "playwright test",
    "toolchain:smoke": "node ./scripts/toolchain-smoke.mjs",
    "toolchain:build": "node ./scripts/toolchain-smoke.mjs --build-only",
    "toolchain:serve": "node ./scripts/toolchain-smoke.mjs --serve"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
